{
  "name": "nubi-app",
  "main": "client/index.js",
  "version": "1.0.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "tsx server/index.ts",
    "dev:server": "tsx server/index.ts",
    "expo:dev": "npx expo start --localhost --port 8082",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=cjs --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "build": "npm run server:build && npx expo export --platform web",
    "start": "node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "seed:reclassify": "npx tsx dev/reclassify-seed-categories.ts",
    "seed:paris-phase1": "npx tsx dev/paris-phase1.ts",
    "seed:report": "npx tsx dev/report-seed-category.ts",
    "seed:refine-adventure": "npx tsx dev/refine-adventure.ts",
    "seed:celeb": "npx tsx dev/seed-celeb-evidence.ts",
    "db:add-celeb-tables": "npx tsx dev/run-add-celeb-tables.ts",
    "report:celeb": "npx tsx dev/report-celeb-evidence.ts",
    "report:mcp": "npx tsx dev/report-mcp-db-status.ts",
    "sync:prices": "npx tsx dev/run-sync-prices.ts",
    "sync:consolidation": "npx tsx dev/run-consolidation.ts",
    "sync:backfill-place-id": "npx tsx dev/run-backfill-place-id.ts",
    "inspect:instagram": "npx tsx dev/inspect-instagram-place-seed.ts",
    "migrate:place-images": "npx tsx dev/migrate-place-images.ts",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "check:types": "tsc --noEmit",
    "check:format": "prettier --check \"**/*.{js,ts,tsx,css,json}\"",
    "format": "prettier --write \"**/*.{js,ts,tsx,css,json}\"",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/noto-serif-kr": "^0.4.3",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@google/genai": "^1.34.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-kakao/core": "^2.4.4",
    "@react-native-kakao/user": "^2.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.91.1",
    "@tanstack/react-query": "^5.90.7",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "dotted-map": "^3.1.0",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1",
    "esbuild": "^0.24.2",
