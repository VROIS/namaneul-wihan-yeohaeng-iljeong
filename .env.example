# ============================================
# 누비 프로젝트 환경변수 템플릿
# 이 파일을 복사해서 .env로 만들고 값을 채우세요
# ============================================

# === 데이터베이스 (Supabase) ===
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# === AI API 키 ===
GEMINI_API_KEY=your_gemini_api_key
AI_INTEGRATIONS_GEMINI_API_KEY=your_gemini_api_key

# === Google Maps ===
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
Google_maps_api_key=your_google_maps_api_key

# === 영상 생성 (Seedance/BytePlus) ===
SEEDANCE_API_KEY=your_seedance_api_key
BYTEPLUS_ACCESS_KEY=your_byteplus_access_key
BYTEPLUS_SECRET_KEY=your_byteplus_secret_key

# === OAuth 로그인 (Google, Kakao, WhatsApp OTP) ===
EXPO_PUBLIC_GOOGLE_CLIENT_ID=   # xxx.apps.googleusercontent.com
# WhatsApp OTP (출시 전 일시정지: false, 출시 시 true)
WHATSAPP_OTP_ENABLED=false      # 서버: OTP API 활성화
EXPO_PUBLIC_WHATSAPP_OTP_ENABLED=false  # 클라이언트: 버튼 표시 (서버와 동기화)

# === 기타 ===
OPENWEATHER_API_KEY=your_openweather_api_key
NODE_ENV=development

# === 로컬 서버 설정 ===
PORT=5000
