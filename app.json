{
  "expo": {
    "name": "TRIPIS",
    "slug": "vibetrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tripis-mark.png",
    "scheme": "vibetrip",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibetrip.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EF",
        "foregroundImage": "./assets/images/tripis-mark.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vibetrip.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/tripis-mark.png",
      "lang": "ko",
      "name": "TRIPIS - 나만의 여행",
      "description": "TRIPIS — AI가 내 취향에 맞게 설계하는 나만의 여행 플래너. 일정·숙소·맛집까지 한 번에."
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tripis-logo-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6EF",
          "dark": {
            "backgroundColor": "#0B0B0D"
          }
        }
      ],
      "expo-web-browser",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "./plugins/withKakaoMavenRepo",
      "./plugins/withAndroidGradleMemory"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "f13f4f4b-7116-44be-b0c8-c91b633a5fb5"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/f13f4f4b-7116-44be-b0c8-c91b633a5fb5"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "vrois"
  }
}
