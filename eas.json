{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "main",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "https://my-guide.replit.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "main",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "https://my-guide.replit.app"
      }
    },
    "production": {
      "channel": "main",
      "environment": "development",
      "env": {
        "EXPO_IMAGE_UTILS_NO_SHARP": "1",
        "EXPO_PUBLIC_DOMAIN": "https://my-guide.replit.app"
