#!/bin/bash
# Native git hook: fires after any successful `git merge` (including `git pull`),
# regardless of whether the merge came from Replit's Task system or the Git pane
# Pull/Sync button. This exists because Replit's platform-level [postMerge] hook
# is documented to be scoped to Agent Task-system merges only, not confirmed for
# Git pane pulls.
#
# NOTE: this can only run build steps. It cannot restart Replit-managed workflows
# (no shell-level API for that) -- workflow restarts after a server change still
# require the agent or the user to do it via the Replit workflow tool/UI.

LOG_FILE=".local/githook-post-merge.log"
mkdir -p .local
{
  echo "===== $(date -u +%Y-%m-%dT%H:%M:%SZ) post-merge git hook fired ====="
  bash scripts/post-merge.sh
  echo "===== post-merge git hook finished ====="
} >> "$LOG_FILE" 2>&1
