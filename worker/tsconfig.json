{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "src.ts",
    "keys.ts",
    "routes-*.ts",
    "raw-store.ts", "call-log.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["node_modules"]
}
