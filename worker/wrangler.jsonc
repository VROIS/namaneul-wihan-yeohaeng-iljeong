{
  "name": "tripis-api",
  "main": "src.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],

  // ⚠️ 수정금지(승인필요) 2026-09-06 사장님 결정 = 가이드 사진 공개주소 = vars 1벌 (검사표 6-6)
  // 근거: developers.cloudflare.com/workers/configuration/environment-variables/
  //   ① "Do not use plaintext environment variables to store sensitive information" =
  //      R2 공개 URL 은 누구나 브라우저로 여는 주소 = 비밀이 아니므로 vars 가 맞다(secret 아님).
  //   ② nodejs_compat + nodejs_compat_populate_process_env(2025-04-01 이후 compat date 기본 켜짐)
  //      = vars 가 process.env 로 자동 노출. 위 compatibility_date=2026-09-05 라 해당됨.
  //      → worker/routes-rest.ts:115 의 process.env.R2_PUBLIC_URL 이 그대로 읽는다.
  //   값 = 원본 .env 와 동일. 이게 없으면 사진은 R2 에 올라가도 imageUrl 이 null 로 떨어진다.
  // ⚠️ 수정금지(승인필요) 2026-09-13 사장님 결정 = DB 접속 = HYPERDRIVE 바인딩만(라우트 openDb() · 엔진 lib/db.ts withEngineDb() = 둘 다 요청별 연결). DATABASE_URL 류 vars 불필요 (정본 §)
  "vars": {
    "R2_PUBLIC_URL": "https://pub-ec584e1b28fc458f85bca053e0fe6b02.r2.dev"
  },
  // ⚠️ 수정금지(승인필요) 2026-09-25 사장님 결정 = 추적 켬 = 카카오 로그인 지연 원인 확인용, 확인 후 끔 (정본 9-25)
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // ⚠️ 수정금지(승인필요) 2026-09-15 사장님 결정 = 관제탑 심장박동 = 1분마다(Workers 최소 주기) (정본 B4)
  "triggers": { "crons": ["* * * * *"] },

  // ⚠️ 수정금지(승인필요) 2026-09-13 사장님 결정 = 운영 엔진(lib/) 복사본이 부르는 "@google/genai" 를 Worker 용 진입점(/web)으로 = 엔진 파일 무변경 (정본 §)
  "alias": {
    "@google/genai": "@google/genai/web",
    "@aws-sdk/client-s3": "./lib/stubs/aws-s3-stub.ts",
    "playwright": "./lib/stubs/playwright-stub.ts"
  },
  // ⚠️ 수정금지(승인필요) 2026-09-13 사장님 결정 = 후처리 자동화 2벌 = Browser Run(구글맵 페이지 열기, @cloudflare/playwright = 기존 page-reader 그대로) + 큐(gmaps-post = MIX 응답 뒤 "도시 N" 한 줄, 소비자 = 같은 워커, 한 번에 한 도시, 재시도 2회 뒤 dead-letter). 배포 전 1회 = `npx wrangler queues create gmaps-post` · `npx wrangler queues create gmaps-post-dlq` (정본 §)
  "browser": { "binding": "BROWSER" },
  "queues": {
    "producers": [{ "binding": "GMAPS_POST_QUEUE", "queue": "gmaps-post" }],
    "consumers": [
      {
        "queue": "gmaps-post",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 1,
        "dead_letter_queue": "gmaps-post-dlq"
      }
    ]
  },
  // ⚠️ 수정금지(승인필요) 2026-09-12 사장님 결정 = 로컬(wrangler dev)은 컨테이너 없이 기동 = 이 PC 8787 실증용 (배포에는 영향 없음)
  "dev": { "enable_containers": false },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "a3b29ca269884582ad73f15f1bc50a84" }
  ],
  // ⚠️ 수정금지(승인필요) 2026-09-06 사장님 결정 = §18 외부호출 raw 저장을 Worker 에서도 하기 위한 R2 바인딩 (정본 §18)
  // 근거: r2/configuration.md:6-15 = wrangler.jsonc 의 "r2_buckets" 는 배열이고 각 원소는 {binding, bucket_name} 2키.
  //       rules.md:172-190 "Use bindings for Cloudflare services, not REST APIs"
  //       = Worker 안에서는 @aws-sdk/client-s3(REST/S3) 대신 네이티브 바인딩을 쓴다.
  "r2_buckets": [
    {
      // 근거: r2/configuration.md:20 "interface Env { MY_BUCKET: R2Bucket; }" = binding 값이 곧 env 의 키 이름(대문자 관례).
      //       우리 용도 = §18 raw(raw-responses/ 프리픽스) 전용 창고 = RAW_BUCKET.
      //       (버킷 자체는 영상과 공유하나 프리픽스로 분리 = server/services/shared/save-raw.ts:10 PREFIX 와 동일 규칙)
      "binding": "RAW_BUCKET",

      // 근거: .env:56 "R2_BUCKET_NAME=tripis-videos" = 운영에서 이미 쓰는 실제 버킷명.
      //       server/services/shared/r2-client.ts:28 이 이 환경변수로 같은 버킷을 가리킨다 = 서버·Worker 동일 창고(§18 2곳 동형).
      "bucket_name": "tripis-videos",

      // ⚠️ 수정금지(승인필요) 2026-09-13 사장님 결정 = 로컬(wrangler dev)도 실제 버킷에 쓰고 읽는다 = 모의 창고에 raw·사진이 갇혀 돈 날리는 일 금지 (공식: r2/get-started/workers-api "remote": true)
      "remote": true
    }
  ],

  // ⚠️ 수정금지(승인필요) 2026-09-06 사장님 결정 = 영상 합성(ffmpeg) 전담 컨테이너 3블록
  // 근거: developers.cloudflare.com/containers/get-started/ = containers · durable_objects ·
  //       migrations 3블록이 한 벌로 있어야 컨테이너가 뜬다(공식 예시 형식 그대로).
  // 왜 필요한가: server/services/video-stitcher.ts:3-8 이 fs·os·path·child_process·
  //       ffmpeg-static 을 쓴다 = Workers 런타임에는 파일시스템도 프로세스 실행도 없어
  //       원리적으로 못 돈다. 컨테이너(Linux VM)가 유일한 길.
  // 🔴 Containers = Workers **Paid 플랜** 필요(공식 pricing = "$5/month Workers Paid plan").
  "containers": [
    {
      // 근거: get-started 공식 예시 "class_name": "MyContainer"
      //   = 아래 durable_objects.bindings[].class_name 및 migrations 의 이름과 **셋 다 같아야** 한다.
      //   실체 = worker/routes-video-generate.ts 의 `export class VideoStitchContainer extends Container`.
      "class_name": "VideoStitchContainer",

      // ⚠️ 수정금지(승인필요) 2026-09-14 사장님 결정 = 이미지 = **이미 구워 올린 것을 주소로 가리킨다** = 이 PC 에서 도커·깃허브 없이 바로 배포한다.
      //   근거(공식) = containers/guides/deploy "If image is a registry reference … you do not need Docker at deploy time."
      //   왜 = 깃허브가 멈추면 업데이트가 통째로 막힌다(2026-09-14 실측 = 문서 2줄 커밋도 배포 실패). 그 의존을 끊는다.
      //   이 주소 = 2026-09-14 12:30 갱신분 = 그 이미지로 12:42 영상 5/5 성공(여정 695) = 검증된 판.
      //   🔴 컨테이너 코드를 고치면 = 새로 구워 올린 뒤 이 줄의 digest 를 바꾼다(굽기는 도커가 있는 자리에서).
      //      되돌아오는 길(굽는 방식) = worker/wrangler.build.jsonc 로 배포하면 된다.
      //   🔴 이미지 말고 다른 칸(vars·r2_buckets·routes 등)을 고치면 wrangler.build.jsonc 에도 같이 옮긴다 = 두 파일은 이미지 지정만 다르고 나머지는 같아야 한다. (정본 §)
      "image": "registry.cloudflare.com/51bcbc629c76db55d6a9aac934b2195f/tripis-api-videostitchcontainer@sha256:a348a125de246d8e93486fbaed712ba176896c52ff2ba28f00d5d98d9da17818",

      // 근거: get-started 공식 예시의 max_instances. 동시에 뜰 수 있는 인스턴스 상한.
      //   일별 영상은 하루 ~5편(Veo Tier2 한도)이라 5면 충분하고, 상한을 낮게 두면
      //   실수로 인스턴스가 번지는 것도 막는다(과금 = 도는 동안만).
      "max_instances": 5,

      // ⚠️ 수정금지(승인필요) 2026-09-12 사장님 결정 = basic(1/4 vCPU·1GiB·4GB) 유지 근거 = 실측(8/22 뮌헨 9씬)
      //   씬 클립 9개 합계 27.5MB(최대 1개 4.7MB) + 완성본 27.4MB. 최악 10씬이어도 메모리 200MB 안쪽.
      //   일은 대부분 외부 응답 대기(제미니·Veo 폴링)라 CPU 도 거의 안 쓴다.
      "instance_type": "basic"
    }
  ],

  // 근거: get-started = 컨테이너는 Durable Object 가 관리한다. 이 바인딩 이름이
  //   Worker 코드의 env 키(= env.VIDEO_STITCH_CONTAINER)가 된다.
  "durable_objects": {
    "bindings": [
      {
        "name": "VIDEO_STITCH_CONTAINER",
        "class_name": "VideoStitchContainer"
      }
    ]
  },

  // 근거: get-started = 새 DO 클래스는 migrations 로 한 번 등록해야 한다.
  //   컨테이너용 DO 는 **new_sqlite_classes** (공식 예시 그대로). tag 는 첫 등록이라 v1.
  //   🔴 이미 배포된 tag 를 고치지 말 것(이력이라 되돌릴 수 없다). 다음 변경은 v2 를 새로 추가.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VideoStitchContainer"]
    }
  ],

  // ⚠️ 수정금지(승인필요) 2026-09-06 사장님 결정 = postgres 를 Cloudflare 전용 빌드로 바꿔치기
  // 근거: postgres 패키지는 Node 전용 소켓을 쓰는 기본 빌드와, Workers 용 cf/ 빌드를 함께 담고 있다.
  //       기본 빌드를 그대로 쓰면 workerd 에서 연결이 안 된다.
  // 🔴 경로는 **명령을 실행한 폴더 기준**이다(설정 파일 기준이 아니다, 2026-09-06 실측).
  //    그래서 postgres 를 **루트 package.json 에도** 넣어 루트 node_modules 에 깔리게 했다.
  //    = 내 PC(worker 폴더에서 실행)든 Workers Builds(저장소 맨 위에서 실행)든 같은 경로가 맞는다.
  // ⚠️ 수정금지(승인필요) 2026-09-06 사장님 결정 = postgres alias 제거 = 패키지 자체 조건에 맡김
  // 근거: node_modules/postgres/package.json 의 exports 에 "workerd": "./cf/src/index.js" 가 이미 있다.
  //       = Workers 로 번들하면 패키지가 스스로 cf 빌드를 고른다. alias 로 파일경로를 박을 필요가 없다.
  // 🔴 옛 alias 는 상대경로("./node_modules/...")라 실행 위치에 따라 깨졌다
  //    (Workers Builds 는 저장소 맨 위에서 실행 = "Cannot find module" 2026-09-06 실측 3회).
  "routes": [
    { "pattern": "test.tripis.app", "custom_domain": true },
    { "pattern": "tripis.app", "custom_domain": true },
    { "pattern": "www.tripis.app", "custom_domain": true }
  ],

  // Workers Assets = C등급 3건(웹화면 GET * / /assets / GET /admin) 을 정적파일로 해결.
  // 조립 = `node scripts/build-worker-assets.mjs` (dist + assets + admin html -> public-dist)
  "assets": {
    // 근거: configuration.md:36 "directory (string, required): Path to assets folder"
    //   worker/ 기준 상대경로이므로 레포 루트의 public-dist 를 가리키려면 ../ 가 필요하다.
    "directory": "../public-dist",

    // 근거: configuration.md:37 / api.md "ASSETS Binding ... Default: ASSETS"
    //   Worker 코드에서 env.ASSETS 로 정적파일을 직접 읽을 필요가 지금은 없으나,
    //   명시해 두면 타입(worker-configuration.d.ts)에 잡혀 나중에 폴백을 쓸 때 재발명이 없다.
    "binding": "ASSETS",

    // 근거: configuration.md:39 및 공식문서 예시 "not_found_handling": "single-page-application"
    //   원본 server/index.ts:214-222 = dist 에 없는 경로면 index.html 을 sendFile = 그대로 SPA 동작.
    "not_found_handling": "single-page-application",

    // 🔴 반드시 배열. true 로 두면 전 요청이 Worker 로 먼저 가는데, 우리 Worker 에는
    //    GET * 핸들러가 없어 웹화면이 전부 404 가 된다.
    //    근거: gotchas.md:3-22 "Use Selective Worker-First Routing" (true 대신 배열 패턴)
    //          configuration.md:66-106 (배열 문법 + 부정 패턴), 공식문서 예시도 배열.
    //    패턴 산정 = worker/src.ts + routes-*.ts 를 전수 grep 한 결과
    //    등록된 라우트 35개가 **전부** "/api/..." 이고 non-/api 라우트는 0건이므로 "/api/*" 1개면 충분하다.
    "run_worker_first": ["/api/*"]
  }
}
